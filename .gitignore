# The NHL model's own repo, created 2026-10-05 at the owner's instruction.
#
# Until today this directory had no version control at all: /nhl/ is gitignored
# by the /root repo (.gitignore:179), so the predictor that produces one of the
# three contests had no history while the picks it produces did. This repo
# exists so a change to the model can be seen, not just hashed.

# Virtualenv -- reinstallable, large, machine-specific.
.venv/

# Built feature and game tables. Regenerated by build_dataset.py /
# build_xg_pregame.py from the nflverse-equivalent NHL sources; large and
# derived, so they are not history.
*.parquet

# Raw source data, downloaded.
data/

# The published pick ledger. It is ALREADY its own git repo with its own
# additive-only integrity check, and nesting it here would either duplicate
# that history or replace it with a gitlink. Left to the repo that owns it.
picks/

# Python bytecode.
__pycache__/
*.pyc
